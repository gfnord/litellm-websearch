FROM python:3.12-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install litellm and all extras
RUN pip install --no-cache-dir "litellm[proxy] == 1.89.1" prisma opentelemetry-api opentelemetry-sdk

# Copy configuration
COPY config.yaml /app/config.yaml

# Expose port
EXPOSE 4000

# Set environment variables
ENV LITELLM_MASTER_KEY=sk-123345sdf
ENV LITELLM_SALT_KEY=sk-123345sdf
ENV LITELLM_LOG=ERROR

# Run litellm proxy
CMD ["litellm", "--config", "/app/config.yaml", "--port", "4000"]
