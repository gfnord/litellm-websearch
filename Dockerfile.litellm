# Base pinned by digest (python:3.12.13-slim); bump tag and digest together.
FROM python:3.12.13-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install litellm, pinned to an exact release. Never float this: litellm 1.107.0
# (PyPI, 2026-10-21) was a supply-chain compromise. 1.109.1 (2026-11-12) is a
# post-incident release and includes the GHSA-2rwg-2wh4-7c4f fix.
RUN pip install --no-cache-dir "litellm[proxy] == 1.109.1" prisma opentelemetry-api opentelemetry-sdk

# Note: config.yaml is bind-mounted at runtime via docker-compose.yml.
# The image ships without a baked-in config so fresh clones can build
# before creating their local config.yaml from config.yaml.example.

# Expose port
EXPOSE 4000

# Set environment variables
# LITELLM_MASTER_KEY and LITELLM_SALT_KEY are injected at runtime from .env via docker-compose.
ENV LITELLM_LOG=ERROR

# Run litellm proxy
CMD ["litellm", "--config", "/app/config.yaml", "--port", "4000"]
