FROM python:3.12.13-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install litellm and all extras.
# fastapi is pinned <0.140.7: that release dropped
# `fastapi.dependencies.utils.get_flat_dependant`, which litellm 1.97.0 imports in
# proxy/management_endpoints/management_v1/common.py. litellm's own range
# (fastapi>=0.136.3,<1.0) still resolves to 0.141.x, so the proxy crashes on import.
# Upstream removed that import in litellm 1.98.0rc1 - drop this pin when 1.98.0 lands.
RUN pip install --no-cache-dir "litellm[proxy] == 1.97.0" "fastapi >= 0.136.3, < 0.140.7" prisma opentelemetry-api opentelemetry-sdk

# Note: config.yaml is bind-mounted at runtime via docker-compose.yml.
# The image ships without a baked-in config so fresh clones can build
# before creating their local config.yaml from config.yaml.example.

# Expose port
EXPOSE 4000

# Set environment variables
# LITELLM_MASTER_KEY and LITELLM_SALT_KEY are injected at runtime from .env via docker-compose.
ENV LITELLM_LOG=ERROR

# Run litellm proxy
CMD ["litellm", "--config", "/app/config.yaml", "--port", "4000"]
